# 客委會帳號密碼
HAKKA_API_USERNAME=your_hakka_username
HAKKA_API_PASSWORD=your_hakka_password

# 客委會即時辨識 WebSocket API
HAKKA_REALTIME_ASR_BASE_URL=https://hkrtasr.bronci.com.tw
HAKKA_REALTIME_ASR_TYPE=file
HAKKA_REALTIME_ASR_RATE=16000
HAKKA_REALTIME_ASR_TIMEOUT_SECONDS=35
HAKKA_REALTIME_ASR_MODEL_NAME=

# 客委會客華雙向文字翻譯 API
HAKKA_MT_BASE_URL=https://hktrans.bronci.com.tw
HAKKA_MT_USERNAME=your_hakka_username
HAKKA_MT_PASSWORD=your_hakka_password

# 線上 LLM API 設定
LLM_API_KEY=your_gemini_or_openai_api_key
LLM_MODEL=gemini-1.5-flash
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
